# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (SQLite for local zero-config, or postgresql://user:pass@localhost:5432/social_comments)
DATABASE_URL="file:./dev.db"

# Platform API Mock/Live Configuration (Mocked by default for zero external credentials)
TWITTER_API_ENABLED=true
INSTAGRAM_GRAPH_API_ENABLED=true
LINKEDIN_REST_API_ENABLED=true
FACEBOOK_GRAPH_API_ENABLED=true
